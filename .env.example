# ============================================================================
# FITFUSION GYM MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ============================================================================

# Environment Runtime Mode
NODE_ENV=development
PORT=3001

# Supabase API Credentials (Obtain from Supabase Project Settings -> API)
# In production, SUPABASE_SERVICE_ROLE_KEY MUST NEVER be exposed to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Supabase JWT Secret (Used for cryptographic server-side JWT verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# PostgreSQL Direct Connection String & Pool Configuration (Stage 5C Production Adapter)
# IMPORTANT: Stage 5C cron automation uses PostgreSQL session-level advisory locks (pg_try_advisory_lock).
# For Supabase / managed Postgres, you MUST use the DIRECT connection port 5432 or Supavisor SESSION mode (port 5432).
# Do NOT use transaction pooler port 6543 (PgBouncer) for cron session advisory locks.
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=true
# SSL Security Invariant: Production connections must validate TLS certificates by default.
# Only set DB_SSL_REJECT_UNAUTHORIZED=false if explicitly testing against self-signed certificates.
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/path/to/server-ca.pem
# Set FORCE_POSTGRES=true to force node-postgres driver even in local dev/test environments
FORCE_POSTGRES=false

# Scheduled Reminders & Internal Automation Secrets
CRON_SECRET=your-strong-random-cron-secret-min-32-chars

# Meta WhatsApp Business Cloud API Gateway (Stage 5B)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_VERIFY_TOKEN=your-random-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-sha256
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=membership_expiry_reminder
WHATSAPP_TIMEOUT_MS=10000

# SMS Gateway (Replaceable Provider, e.g. Twilio / Indian DLT Gateway) (Stage 5B)
SMS_ENABLED=false
SMS_ACCOUNT_SID=your-sms-account-sid
SMS_AUTH_TOKEN=your-sms-auth-token
SMS_FROM_NUMBER=+1234567890
SMS_TIMEOUT_MS=10000

# Provider Safety & Reconciliation Overrides (Non-production testing only)
DISABLE_WEBHOOK_VERIFICATION=false
ALLOW_MOCK_IN_PROD=false

# Gym Business Profile Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
